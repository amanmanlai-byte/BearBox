{
  "name": "BearBox-desktop",
  "productName": "BearBox",
  "version": "0.3.0-preview.2",
  "description": "BearBox desktop client for Windows (sing-box 1.14.3-Jiajia-7 core)",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "pack:win": "electron-packager . BearBox --platform=win32 --arch=x64 --out=../dist --overwrite --prune=true --icon=assets/icon.ico --ignore=\"^/test\" --ignore=\"^/tools\" --ignore=\"^/core/sing-box-linux\" --ignore=\"^/package-lock.json\" --ignore=\"^/node_modules/(?!(js-yaml|argparse)(/|$))\"",
    "dist:win": "electron-builder --win",
    "test:unit": "node --test test/*.test.js"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "com.bearbox.desktop",
    "productName": "Bear Box",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "geo/**/*",
      "package.json",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "core/",
        "to": "core/"
      },
      {
        "from": "ruleset/",
        "to": "ruleset/"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bear Box"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB"
    ]
  }
}
